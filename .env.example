# Copy to .env (never commit). Paper and live credentials are separate on purpose.
SEA_LION_MODE=shadow                 # backtest | shadow | sim | paper | live

# --- Alpaca paper trading (https://app.alpaca.markets -> Paper Trading -> API keys)
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
# --- Alpaca live (leave empty until the paper gate has been met)
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
# Live mode additionally requires BOTH of these, every day:
SEA_LION_LIVE_ENABLED=0
SEA_LION_LIVE_CONFIRM_TOKEN=

# --- AI providers
# Local OpenAI-compatible server (vLLM / llama.cpp). No key needed; any non-empty string.
SEA_LION_LOCAL_LLM_URL=http://127.0.0.1:8324/v1
SEA_LION_LOCAL_LLM_MODEL=deepseek-v4-flash-q4
# Optional cloud tier for the "main" model (only used if config ai.main.provider = anthropic)
ANTHROPIC_API_KEY=
